{
  "name": "adertha-client",
  "version": "0.1.0",
  "description": "Adertha desktop app",
  "private": true,
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "app": "node scripts/app.mjs",
    "start:dev": "electron . --dev",
    "start": "vite build && electron .",
    "build:core": "node scripts/build-core.mjs",
    "dist": "npm run build:core && vite build && electron-builder"
  },
  "build": {
    "appId": "com.adertha.app",
    "productName": "Adertha",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build/core",
        "to": "core"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Adertha-Setup.${ext}"
    },
    "mac": {
      "target": "dmg",
      "artifactName": "Adertha.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "artifactName": "Adertha.${ext}",
      "category": "Development"
    }
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.8"
  }
}
